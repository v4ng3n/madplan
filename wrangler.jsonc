{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madplan",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "madplan-db",
      "database_id": "80033131-8207-42f2-aaf1-47ecc2d7f385"
    }
  ]
}
